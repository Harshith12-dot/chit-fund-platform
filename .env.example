# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
# Path to the embedded SQLite database file
DB_PATH=./data/chitfund.db

# Security & Cryptography
# Secret salt for HMAC auction result signatures (change in production!)
AUCTION_HMAC_SECRET=chit-fund-secure-auction-secret-key-production-change-me

# Session Expiry (in seconds, default: 7 days)
SESSION_EXPIRY_SECONDS=604800
